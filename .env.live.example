# =============================================================================
#  CAPA 3 — tests contra un PlanVortex de VERDAD.
#
#  Copialo a `.env.live` (que esta gitignorado) y rellena lo de abajo. Despues:
#
#      uv run pytest -m live
#
#  Sin este fichero, `uv run pytest -m live` no falla: se salta entero diciendo que falta.
#  Y `uv run pytest` a secas (capas 1 y 2) ni siquiera recoge la capa 3, porque `addopts`
#  lleva `-m "not live"`: salir a la red se pide en voz alta.
# =============================================================================

# Contra que servidor. CON el prefijo de version y sin barra final.
# Lo normal es tu stack local (`docker compose up -d` en PlanVortexServer).
PLANVORTEX_LIVE_BASE_URL=http://localhost:8089/v1.0.0

# Credenciales de una app de cliente (panel: Ajustes > Apps). Llevan prefijo LIVE_ a
# proposito: un `.env` con las credenciales de produccion NO debe armar esta suite.
PLANVORTEX_LIVE_CLIENT_ID=
PLANVORTEX_LIVE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  Que organizacion y que cuenta. Opcionales: sin esto se coge la primera.
# -----------------------------------------------------------------------------

# LIVE_ORGANIZATION_ID=
# LIVE_ACCOUNT_ID=

# La imagen que se sube en las pruebas de escritura. Por defecto NO hay fichero: la
# suite se genera un PNG de 1080x1080 con `zlib`, porque una libreria de cliente no
# lleva una foto dentro para sus tests. Esto la sustituye por una del disco.
# LIVE_IMAGE_PATH=./hogaza.jpg

# Un video, para las redes que no publican imagenes. No hay uno por defecto —un MP4 no
# se genera con `zlib`—, asi que sin esto la prueba de publicacion se salta cuando la
# unica cuenta conectada es de YouTube o TikTok. Vale cualquier MP4 corto:
#
#     ffmpeg -f lavfi -i color=c=black:s=640x360:d=3 -f lavfi -i anullsrc -shortest \
#            -c:v libx264 -pix_fmt yuv420p -c:a aac live.mp4
#
# LIVE_VIDEO_PATH=./live.mp4


# -----------------------------------------------------------------------------
#  Interruptores de escritura. Todos apagados por defecto.
# -----------------------------------------------------------------------------

# Permite SUBIR ficheros y CREAR publicaciones. Lo que se crea se programa a un dia vista
# y se borra al terminar el test, asi que no sale a ninguna red social.
LIVE_ALLOW_PUBLISH=0

# Permite PUBLICAR YA, de verdad, en la red conectada. Interruptor aparte del anterior por
# la misma razon por la que el servidor separa los comentarios: programar es privado y
# reversible; publicar es publico, inmediato y le llega a gente.
# LIVE_ALLOW_SOCIAL_PUBLISH=1

# Escribir contra api.planvortex.com exige decirlo dos veces. Sin esto, la suite revienta
# nada mas arrancar en vez de tocar una organizacion real.
# LIVE_ALLOW_PRODUCTION=1

# Otro fichero de entorno, si prefieres tener varios (uno por stack, por ejemplo).
# LIVE_ENV_FILE=.env.live.produccion
